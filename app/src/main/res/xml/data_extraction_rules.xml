<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules (API 31+).

   The antminer_saved_profiles shared-preferences file holds the saved
   miner profiles, including their device passwords. Exclude it from both
   cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="antminer_saved_profiles.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="antminer_saved_profiles.xml" />
    </device-transfer>
</data-extraction-rules>
