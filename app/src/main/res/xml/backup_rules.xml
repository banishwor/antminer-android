<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android Auto Backup (this file applies before API 31;
   API 31+ uses data_extraction_rules.xml).

   The antminer_saved_profiles shared-preferences file holds the saved
   miner profiles, including their device passwords. It must never leave
   the device through cloud backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="antminer_saved_profiles.xml" />
</full-backup-content>
